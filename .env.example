# Browser-visible API base. Empty uses the bundled /api demo routes.
# Supply an API-compatible .NET backend URL here when integrating it.
# NEXT_PUBLIC_* values are compiled into the browser bundle at build time.
NEXT_PUBLIC_API_BASE_URL=

# Server-only writable directory; data.json is seeded automatically.
DEMO_DATA_DIR=.demo

# Host port used by Docker Compose (container port remains 3000).
PORT=3000
